{
  "name": "valuescale",
  "version": "1.3.0",
  "description": "Always-on-top grayscale projection for artists",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.valuescale.app",
    "productName": "ValueScale",
    "artifactName": "ValueScale_${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "auto-updater.js",
      "preload.js",
      "index.html",
      "crop-selection.html",
      "panel.html",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/valuescale-icon.ico"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
